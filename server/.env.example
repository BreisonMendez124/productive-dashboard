# ──────────────────────────────────────────────
# WMS Dashboard — variables de entorno
# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el .env real al repositorio.
# ──────────────────────────────────────────────

# Puerto del servidor (default: 4000)
PORT=4000

# SQL Server
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_CERT=true

# Orígenes permitidos por CORS (separados por coma)
# En producción pon la IP/hostname real del TV o del servidor web
# Ejemplo: CORS_ORIGINS=http://10.0.1.50,http://tv-almacen.gecolsa.local
CORS_ORIGINS=http://localhost:5173

# Entorno (development | production)
NODE_ENV=development

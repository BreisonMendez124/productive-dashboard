# ──────────────────────────────────────────────────────────────
# WMS Dashboard — variables de entorno del cliente (Vite)
# Copia este archivo como ".env" y ajusta VITE_API_BASE.
# Las variables DEBEN empezar con VITE_ para ser expuestas.
# ──────────────────────────────────────────────────────────────

# URL base del servidor backend
# Desarrollo local:
VITE_API_BASE=http://localhost:4000

# Producción (ejemplo — ajusta a la IP/hostname real):
# VITE_API_BASE=http://10.0.1.100:4000
